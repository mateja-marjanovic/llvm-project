; StrictLMUL has no fractional LMUL: the post-RA vtype adjustment rewrites an
; e8,mf2 vslideup to e16,m1, which changes the slide offset and VL (both counted
; in elements). Subvector inserts/extracts into/out of a fractional container
; must therefore be slid on the LMUL=1 type, keeping SEW=8.

declare <vscale x 1 x i8> @llvm.vector.extract.nxv1i8.nxv4i8(<vscale x 4 x i8>, i64)
declare <vscale x 4 x i8> @llvm.vector.insert.nxv4i8.nxv1i8(<vscale x 4 x i8>, <vscale x 1 x i8>, i64)

define <vscale x 4 x i8> @insert_nxv1i8_nxv4i8_1(<vscale x 4 x i8> %vec, <vscale x 1 x i8> %sub) {
; CHECK-LABEL: insert_nxv1i8_nxv4i8_1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 4, e8, m1, tu, ma
; CHECK-NEXT:    vslideup.vi v8, v9, 2
; CHECK-NEXT:    ret
  %r = call <vscale x 4 x i8> @llvm.vector.insert.nxv4i8.nxv1i8(<vscale x 4 x i8> %vec, <vscale x 1 x i8> %sub, i64 1)
  ret <vscale x 4 x i8> %r
}

define <vscale x 4 x i8> @insert_nxv1i8_nxv4i8_3(<vscale x 4 x i8> %vec, <vscale x 1 x i8> %sub) {
; CHECK-LABEL: insert_nxv1i8_nxv4i8_3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 8, e8, m1, tu, ma
; CHECK-NEXT:    vslideup.vi v8, v9, 6
; CHECK-NEXT:    ret
  %r = call <vscale x 4 x i8> @llvm.vector.insert.nxv4i8.nxv1i8(<vscale x 4 x i8> %vec, <vscale x 1 x i8> %sub, i64 3)
  ret <vscale x 4 x i8> %r
}

define <vscale x 1 x i8> @extract_nxv1i8_nxv4i8_2(<vscale x 4 x i8> %vec) {
; CHECK-LABEL: extract_nxv1i8_nxv4i8_2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 16, e8, m1, ta, ma
; CHECK-NEXT:    vslidedown.vi v8, v8, 4
; CHECK-NEXT:    ret
  %r = call <vscale x 1 x i8> @llvm.vector.extract.nxv1i8.nxv4i8(<vscale x 4 x i8> %vec, i64 2)
  ret <vscale x 1 x i8> %r
}

; Truncating a wide vector piecewise and storing it with an EVL reassembles the
; pieces with vslideup into a fractional nxv4i8.
declare void @llvm.vp.store.nxv4i8.p0(<vscale x 4 x i8>, ptr, <vscale x 4 x i1>, i32)

define void @trunc_vp_store(ptr %p, <vscale x 4 x i64> %v, i32 zeroext %evl) {
; CHECK-LABEL: trunc_vp_store:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 2, e8, m1, ta, ma
; CHECK-NEXT:    vid.v v12
; CHECK-NEXT:    vsll.vi v12, v12, 3
; CHECK-NEXT:    vrgather.vv v13, v9, v12
; CHECK-NEXT:    vrgather.vv v9, v8, v12
; CHECK-NEXT:    vsetivli zero, 4, e8, m1, tu, ma
; CHECK-NEXT:    vslideup.vi v9, v13, 2
; CHECK-NEXT:    vsetivli zero, 2, e8, m1, ta, ma
; CHECK-NEXT:    vrgather.vv v8, v10, v12
; CHECK-NEXT:    vsetivli zero, 6, e8, m1, tu, ma
; CHECK-NEXT:    vslideup.vi v9, v8, 4
; CHECK-NEXT:    vsetivli zero, 2, e8, m1, ta, ma
; CHECK-NEXT:    vrgather.vv v8, v11, v12
; CHECK-NEXT:    vsetivli zero, 8, e8, m1, tu, ma
; CHECK-NEXT:    vslideup.vi v9, v8, 6
; CHECK-NEXT:    vsetvli zero, a1, e16, m1, ta, ma
; CHECK-NEXT:    vse8.v v9, (a0)
; CHECK-NEXT:    ret
  %t = trunc <vscale x 4 x i64> %v to <vscale x 4 x i8>
  call void @llvm.vp.store.nxv4i8.p0(<vscale x 4 x i8> %t, ptr %p, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  ret void
}
